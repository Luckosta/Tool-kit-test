{
    "name": "tool-kit",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "lint:es:fix": "eslint . --ext .ts,.tsx --fix",
        "lint:styled": "stylelint ./src/**/*.{ts,tsx} --fix",
        "test": "vitest --coverage",
        "preview": "vite preview"
    },
    "dependencies": {
        "effector": "^23.3.0",
        "graphql": "^16.10.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-router-dom": "^7.1.5"
    },
    "devDependencies": {
        "@eslint/js": "^9.19.0",
        "@types/node": "^22.13.1",
        "@types/react": "^19.0.8",
        "@types/react-dom": "^19.0.3",
        "@vitejs/plugin-react": "^4.3.4",
        "eslint": "^9.20.0",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-react-hooks": "^5.0.0",
        "eslint-plugin-react-refresh": "^0.4.18",
        "globals": "^15.14.0",
        "stylelint": "^16.14.1",
        "stylelint-config-standard": "^37.0.0",
        "typescript": "~5.7.2",
        "typescript-eslint": "^8.22.0",
        "vite": "^6.1.0"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "npx eslint --fix",
            "stylelint ./src/**/*.{ts,tsx} --fix",
            "prettier --write"
        ]
    }
}
