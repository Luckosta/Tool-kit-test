{
    "name": "tool-kit",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "start": "vite",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "lint:es:fix": "eslint . -c .ts,.tsx --fix",
        "lint:styled": "stylelint ./src/**/*.{css} --fix",
        "test": "vitest --coverage",
        "preview": "vite preview"
    },
    "dependencies": {
        "@apollo/client": "^3.12.11",
        "effector": "^23.3.0",
        "effector-react": "^23.3.0",
        "graphql": "^16.10.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-router-dom": "^7.1.5"
    },
    "devDependencies": {
        "@eslint/js": "^9.20.0",
        "@evilmartians/lefthook": "^1.10.10",
        "@types/node": "^22.13.1",
        "@types/prettier": "^2.7.3",
        "@types/react": "^19.0.8",
        "@types/react-dom": "^19.0.3",
        "@vitejs/plugin-react": "^4.3.4",
        "eslint": "^9.20.0",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-react": "^7.37.4",
        "eslint-plugin-react-hooks": "^5.1.0",
        "globals": "^15.14.0",
        "lint-staged": "^15.4.3",
        "prettier": "^3.4.2",
        "stylelint": "^16.14.1",
        "stylelint-config-standard": "^37.0.0",
        "typescript": "~5.7.2",
        "typescript-eslint": "^8.23.0",
        "vite": "^6.1.0"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "npx eslint --fix",
            "prettier --write"
        ],
        "*.css": [
            "npx stylelint --fix",
            "prettier --write"
        ]
    }
}
